
NODE_ENV=development
API_PREFIX=api/v1


LOG_LEVEL=
LOG_FORMAT=

PRISMA_LOG_QUERIES=false

SLOW_QUERY_MS=300
VITE_API_URL=http://localhost:4000/api/v1
VITE_LOG_LEVEL=

WEB_APP_URL=http://localhost:8080

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

API_CONTAINER_PORT=4000
API_HOST_PORT=4000
WEB_CONTAINER_PORT=8080
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SMTP_HOST_PORT=1025
MAILPIT_UI_PORT=8025

# Also read by the API when it is run directly rather than in a container.
PORT=4000

# The interface the API binds. `0.0.0.0` is every IPv4 interface, which is what
# every container platform's port scanner probes — bind anything narrower and
# the service is reported as having no open ports even though it is running.
# Set `::` locally if you want dual-stack; do not set it in a deployment.
HOST=0.0.0.0

# --- Database --------------------------------------------------------------
# Credentials for the Postgres container.
POSTGRES_USER=ciq
POSTGRES_PASSWORD=ciq_dev_password
POSTGRES_DB=constructiq


DATABASE_URL=postgresql://ciq:ciq_dev_password@localhost:5433/constructiq?schema=public
DOCKER_DATABASE_URL=postgresql://ciq:ciq_dev_password@postgres:5432/constructiq?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Administrator
BOOTSTRAP_ORG_NAME=

BOOTSTRAP_ORG_SLUG=


STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=ciq-attachments
S3_ACCESS_KEY_ID=ciq_minio
S3_SECRET_ACCESS_KEY=ciq_minio_password
# MinIO needs path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_MB=25

# Same host/container split as the database above.
S3_ENDPOINT=http://localhost:9000
DOCKER_S3_ENDPOINT=http://minio:9000

# --- Email ------------------------------------------------------------------
# `brevo` posts to Brevo's HTTP API with an xkeysib- key. `smtp` speaks SMTP to
# any relay. `log` writes messages to the log and sends nothing.
MAIL_DRIVER=brevo
BREVO_API_KEY=
EMAIL_FROM=alert@goyalco.email
EMAIL_FROM_NAME=Goyal & Co | Hariyana Group

# SMTP, for MAIL_DRIVER=smtp. Locally that is the mailpit container from docker
# compose — read the inbox on MAILPIT_UI_PORT; nothing leaves the machine.
# DOCKER_SMTP_HOST is the same relay as reached from inside the compose network,
# where it is a service name rather than localhost. docker-compose.yml
# substitutes it, so removing it leaves the api service with an empty SMTP host.
SMTP_HOST=localhost
DOCKER_SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=


ENABLE_SCHEDULER=true
DIGEST_CRON=0 3 * * 1
RISK_SWEEP_CRON=0 2 * * *
