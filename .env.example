# ---------------------------------------------------------------------------
# ConstructIQ Tracker — environment
#
# Copy to `.env` for local work. Every value below has a working local default
# that matches docker-compose.yml, except the JWT secrets, which you must set.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Local (docker compose). For Neon, paste the pooled connection string and keep
# ?sslmode=require — Neon rejects unencrypted connections.
DATABASE_URL=postgresql://ciq:ciq_dev_password@localhost:5433/constructiq?schema=public

# --- Auth ------------------------------------------------------------------
# MUST be changed before any deployment. The API refuses to boot in production
# if these are left at their placeholder values.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Failed logins before the account locks, and how long it stays locked.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Redis (queues, digest scheduling, rate-limit store) -------------------
REDIS_URL=redis://localhost:6380

# --- Object storage (attachments) ------------------------------------------
# Any S3-compatible endpoint: MinIO locally, AWS S3 or Cloudflare R2 in prod.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ciq-attachments
S3_ACCESS_KEY_ID=ciq_minio
S3_SECRET_ACCESS_KEY=ciq_minio_password
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_MB=25

# --- Email ------------------------------------------------------------------
# Local: mailpit on 1025 (open http://localhost:8025 to read what was sent).
# Production: your SMTP relay, or set MAIL_DRIVER=log to disable sending.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ConstructIQ Tracker <no-reply@constructiq.local>"

# --- Scheduled jobs ---------------------------------------------------------
# Nightly risk sweep and weekly management digest. Set to false on replicas so
# only one instance runs the cron.
ENABLE_SCHEDULER=true
DIGEST_CRON=0 3 * * 1
RISK_SWEEP_CRON=0 2 * * *

# --- Web client -------------------------------------------------------------
# Read by Vite at build time. Must be the public URL of the API.
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=ConstructIQ Tracker
