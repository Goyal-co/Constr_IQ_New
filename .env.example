# ---------------------------------------------------------------------------
# ConstructIQ Tracker — the single configuration file
#
#   cp .env.example .env
#
# Read by two things:
#
#   • docker-compose.yml, which substitutes every ${...} in it. Nothing is
#     configured inside that file or inside either Dockerfile — moving the API
#     to a new host, pointing at a managed database, or putting the web app on a
#     real domain is a change here and nowhere else.
#   • the API itself, when run locally with `npm run dev`.
#
# Values below are a working localhost setup. Change them for anything else.
# This file is committed; `.env` is not — never put a real secret here.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PREFIX=api/v1

# --- Public URLs -----------------------------------------------------------
# The three addresses that change when the deployment moves. They are the whole
# reason this file exists.

# The API's public base URL, including the prefix, no trailing slash. Compiled
# into the web bundle at BUILD time, so changing it means rebuilding the web
# image — a restart is not enough.
VITE_API_URL=http://localhost:4000/api/v1

# Where the web app is served from. Used in emailed links.
WEB_APP_URL=http://localhost:8080

# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Must include WEB_APP_URL. The Vite dev server on 5173 is listed so `npm run
# dev` works against a containerised API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Ports -----------------------------------------------------------------
# `*_HOST_PORT` is what you reach from the machine; `*_CONTAINER_PORT` is what
# the process binds inside its container. They differ where a default port is
# likely to already be taken.
API_CONTAINER_PORT=4000
API_HOST_PORT=4000
WEB_CONTAINER_PORT=8080
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SMTP_HOST_PORT=1025
MAILPIT_UI_PORT=8025

# Also read by the API when it is run directly rather than in a container.
PORT=4000

# --- Database --------------------------------------------------------------
# Credentials for the Postgres container.
POSTGRES_USER=ciq
POSTGRES_PASSWORD=ciq_dev_password
POSTGRES_DB=constructiq

# How the API reaches it. Two forms, because the address differs by where the
# API is running:
#
#   DATABASE_URL         from the host — `npm run dev`, migrations, the seed.
#                        Uses POSTGRES_HOST_PORT.
#   DOCKER_DATABASE_URL  from inside the compose network — service name and the
#                        container's own 5432.
#
# For a managed database (Neon, RDS, Cloud SQL) set both to the same connection
# string and keep ?sslmode=require.
DATABASE_URL=postgresql://ciq:ciq_dev_password@localhost:5433/constructiq?schema=public
DOCKER_DATABASE_URL=postgresql://ciq:ciq_dev_password@postgres:5432/constructiq?schema=public

# --- Auth ------------------------------------------------------------------
# MUST be replaced before any deployment, and must differ from each other: one
# secret for both would make a refresh token usable as an access token.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- First administrator ---------------------------------------------------
# Read only by the bootstrap, which creates one account and nothing else — no
# phases, no categories, no sample projects.
#
#   npm run db:seed -w @ciq/api        from a development checkout
#   npm run db:seed:dist -w @ciq/api   inside a container (no ts-node there)
#
# Run it once, after the first deploy. Re-running is safe: it never overwrites
# an existing account's password. Remove BOOTSTRAP_OWNER_PASSWORD from the
# deployment environment once the account exists — nothing reads it again.
#
# There is no default for any of these. A default administrator password in a
# repository is a published password.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Administrator
BOOTSTRAP_ORG_NAME=
# Optional — derived from BOOTSTRAP_ORG_NAME when blank. It is the stable
# identifier, so renaming the organisation later does not affect it.
BOOTSTRAP_ORG_SLUG=

# --- Object storage (attachments) ------------------------------------------
# `local` writes to disk inside the container, which does not survive a
# redeploy. Use `s3` against any S3-compatible endpoint for anything real.
STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=ciq-attachments
S3_ACCESS_KEY_ID=ciq_minio
S3_SECRET_ACCESS_KEY=ciq_minio_password
# MinIO needs path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_MB=25

# Same host/container split as the database above.
S3_ENDPOINT=http://localhost:9000
DOCKER_S3_ENDPOINT=http://minio:9000

# --- Email ------------------------------------------------------------------
# `brevo` posts to Brevo's HTTP API with an xkeysib- key. `smtp` speaks SMTP to
# any relay. `log` writes messages to the log and sends nothing.
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@constructiq.local
MAIL_FROM_NAME=ConstructIQ Tracker
BREVO_API_KEY=

# Locally this is the mailpit container — read the inbox on MAILPIT_UI_PORT.
SMTP_HOST=localhost
DOCKER_SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Scheduled jobs ---------------------------------------------------------
# Nightly risk sweep and weekly digest. Set false on every replica but one, and
# on any host that suspends idle instances — a cron that fires whenever somebody
# happens to wake the service is worse than one that does not run.
ENABLE_SCHEDULER=true
DIGEST_CRON=0 3 * * 1
RISK_SWEEP_CRON=0 2 * * *
