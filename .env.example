
NODE_ENV=development
API_PREFIX=api/v1

LOG_LEVEL=info
LOG_FORMAT=json

PRISMA_LOG_QUERIES=false

SLOW_QUERY_MS=300
VITE_API_URL=http://localhost:4000/api/v1
VITE_LOG_LEVEL=info

WEB_APP_URL=http://localhost:8080

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

API_CONTAINER_PORT=4000
API_HOST_PORT=4000
WEB_CONTAINER_PORT=8080
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=5433

PORT=4000

HOST=0.0.0.0

POSTGRES_USER=ciq
POSTGRES_PASSWORD=ciq_dev_password
POSTGRES_DB=constructiq

DATABASE_URL=postgresql://ciq:ciq_dev_password@localhost:5433/constructiq?schema=public
DOCKER_DATABASE_URL=postgresql://ciq:ciq_dev_password@postgres:5432/constructiq?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

BOOTSTRAP_OWNER_EMAIL=superadmin@goyalco.email
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Super Admin
BOOTSTRAP_ORG_NAME=Goyal & Co | Hariyana Group

BOOTSTRAP_ORG_SLUG=goyal-co

MAX_UPLOAD_MB=25

# Where attachments are written. Note that a container filesystem does not
# survive a redeploy, so anything stored here is lost on restart — fine while
# nothing can upload, and the thing to fix before an upload UI exists.
LOCAL_UPLOAD_DIR=./uploads

MAIL_DRIVER=brevo
BREVO_API_KEY=
EMAIL_FROM=alert@goyalco.email
EMAIL_FROM_NAME=Goyal & Co | Hariyana Group

ENABLE_SCHEDULER=true
DIGEST_CRON=0 3 * * 1
RISK_SWEEP_CRON=0 2 * * *
