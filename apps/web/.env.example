# ---------------------------------------------------------------------------
# Web client environment — this is the complete list for Vercel
# ---------------------------------------------------------------------------
# One variable. That is all Vercel needs.
#
# There is no DATABASE_URL, no JWT secret, no SMTP and no S3 here, and none of
# them should ever be added: this app is a static bundle served from a CDN, so
# anything set here is compiled into JavaScript that every visitor downloads.
# Treat every value below as public. Secrets belong to the API deployment.
#
# Vite only exposes variables prefixed `VITE_`, which is the guard rail that
# makes that mistake hard rather than silent — but it does not stop you from
# prefixing a secret, so the rule above still stands.
# ---------------------------------------------------------------------------

# The API's public base URL, including the /api/v1 prefix, no trailing slash.
#
#   local     http://localhost:4000/api/v1
#   deployed  https://your-api.up.railway.app/api/v1
#
# Read at BUILD time and baked into the bundle: changing it in the Vercel
# dashboard does nothing until you redeploy.
VITE_API_URL=http://localhost:4000/api/v1

# There is deliberately no VITE_APP_NAME. The title is set in index.html and the
# sign-in screen renders the brand lockup, so a second source for the same
# string would only be one more thing to keep in sync.
