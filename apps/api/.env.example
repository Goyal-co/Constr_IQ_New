# ---------------------------------------------------------------------------
# ConstructIQ Tracker — API environment
#
# Copy to `.env` for local work. Only two values have no working default:
# DATABASE_URL and the two JWT secrets.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# NOTE: none of this belongs on Vercel. Vercel serves the web client, which is a
# static bundle and reads only the VITE_* values at the bottom of this file. The
# variables above them belong wherever the API runs (Railway, Render, Fly, a VM).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Comma-separated browser origins allowed to call the API. In production this is
# your Vercel URL — including any custom domain you point at it.
CORS_ORIGINS=http://localhost:5173

# Used in links inside notification emails.
WEB_APP_URL=http://localhost:5173

# --- Database (required) ---------------------------------------------------
# Local docker compose maps Postgres to 5433 to avoid clashing with a system
# install on 5432. For Neon, paste the POOLED connection string and keep
# ?sslmode=require.
DATABASE_URL=postgresql://ciq:ciq@localhost:5433/ciq?schema=public

# --- Auth (required) -------------------------------------------------------
# Both must be at least 32 characters and must differ from each other — a
# refresh secret equal to the access secret makes a refresh token a valid access
# token. The API refuses to boot in production if either is left at the sample
# value below.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- First-run bootstrap ---------------------------------------------------
# Read only by `npm run db:seed`, which creates the organisation, the owner
# account and the two work phases. Re-running it never overwrites an existing
# account's password.
BOOTSTRAP_OWNER_EMAIL=superadmin@goyalco.com
BOOTSTRAP_OWNER_PASSWORD=Goyalco@12@
BOOTSTRAP_OWNER_NAME=Super Admin
BOOTSTRAP_ORG_NAME=Goyal & Co. | Hariyana Group
BOOTSTRAP_ORG_SLUG=goyal-co-hariyana-group

# --- Attachments -----------------------------------------------------------
# `local` writes to LOCAL_UPLOAD_DIR and serves files through the API's own
# download route. No object store, no credentials.
#
# The catch: most container hosts give you an ephemeral filesystem, so uploads
# vanish on redeploy. That is fine if nobody uses attachments, and fine if you
# mount a persistent volume at LOCAL_UPLOAD_DIR. If neither is true, set
# STORAGE_DRIVER=s3 and fill in the block below — any S3-compatible endpoint
# works (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Only read when STORAGE_DRIVER=s3. Boot fails without the two credentials.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ciq-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_SIGNED_URL_TTL_SECONDS=900

# --- Email -----------------------------------------------------------------
# Three drivers.
#
#   log    messages go to the application log. The default: a fresh deployment
#          sends nothing until you opt in. In-app notifications still work —
#          only the emailed copy is suppressed — so this is a fine permanent
#          setting if nobody wants the weekly digest in their inbox.
#
#   brevo  Brevo's HTTP API. Use this if you have an `xkeysib-…` API key.
#
#   smtp   any SMTP relay, Brevo's included. Use this if you have an SMTP
#          login and SMTP key.
#
# `brevo` and `smtp` are separate settings because Brevo issues two different
# credentials and its SMTP relay does NOT accept a v3 API key. Pasting one into
# SMTP_PASSWORD fails with an opaque 535, so the API refuses to boot on that
# combination and tells you which setting you want instead.
#
# The HTTP driver is also safer on container hosts, which commonly block
# outbound 587/465 — SMTP there fails by hanging until timeout, which reads as a
# stuck digest job rather than a misconfiguration.
MAIL_DRIVER=log

# The sender. Must be an address Brevo has verified under
# Senders, Domains & Dedicated IPs, or it is rejected at submission.
MAIL_FROM=alert@goyalco.email
MAIL_FROM_NAME=Goyal & Co | Hariyana Group

# --- Option A: Brevo HTTP API (MAIL_DRIVER=brevo) --------------------------
# From Brevo -> SMTP & API -> API Keys. Starts with `xkeysib-`.
# BREVO_API_KEY=

# --- Option B: SMTP (MAIL_DRIVER=smtp) -------------------------------------
# From Brevo -> SMTP & API -> SMTP. SMTP_USER is the login shown there (an
# address like 8a1b2c001@smtp-brevo.com), NOT your account email; SMTP_PASSWORD
# is the SMTP key, NOT an API key.
#
# Port 587 with SMTP_SECURE=false is correct — the session starts in the clear
# and upgrades via STARTTLS. Setting it true on 587 breaks the handshake. For
# implicit TLS use 465 with SMTP_SECURE=true. Brevo also listens on 2525 for
# hosts that block 587.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Scheduled jobs --------------------------------------------------------
# The nightly risk sweep and the weekly management digest. Set to false on every
# replica but one, or two instances will both run the cron.
ENABLE_SCHEDULER=true
RISK_SWEEP_CRON=0 2 * * *
DIGEST_CRON=0 3 * * 1

# ---------------------------------------------------------------------------
# Web client — THESE are the ones Vercel needs
# ---------------------------------------------------------------------------
# One variable, read by Vite at BUILD time and baked into the bundle — changing
# it needs a redeploy, not a restart. The API's public URL, including the
# /api/v1 prefix, with no trailing slash.
#
# Kept here only so a local `npm run dev` at the repo root picks it up. On
# Vercel it is set in the project's own environment; see apps/web/.env.example.
VITE_API_URL=http://localhost:4000/api/v1
